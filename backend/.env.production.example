# 知日塾大学院考学进度管理系统 - 生产环境变量模板
# 复制为 .env.production 后逐项填写，禁止提交真实密钥到仓库。
# 强制要求：NODE_ENV=production，所有 *_SECRET / *_PASSWORD / *_KEY 必须替换为真实值。

# ═══════════════════════════════════════
# 运行模式
# ═══════════════════════════════════════
NODE_ENV="production"
HOST="0.0.0.0"
PORT=3000
LOG_LEVEL="info"
# 仅排障时短暂打开，会把 500 错误的 message 暴露到响应体
EXPOSE_ERROR_DETAILS="false"

# ═══════════════════════════════════════
# 数据库 / Redis
# ═══════════════════════════════════════
DATABASE_URL="postgresql://USER:PASS@DB_HOST:5432/chinichi_graduate?schema=public"
REDIS_URL="redis://:PASS@REDIS_HOST:6379"

# ═══════════════════════════════════════
# JWT - 必须替换为 ≥32 字符高熵随机串
#   生成示例: openssl rand -base64 48
# ═══════════════════════════════════════
JWT_SECRET="REPLACE_WITH_openssl_rand_base64_48_OUTPUT"
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="30d"

# ═══════════════════════════════════════
# 初始管理员密码（仅 prisma:seed 一次性使用，部署完成后可清空）
#   ≥12 字符，强烈建议含大小写+数字+符号
# ═══════════════════════════════════════
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# ═══════════════════════════════════════
# CORS - 允许的前端域名，逗号分隔
# ═══════════════════════════════════════
CORS_ORIGIN="https://chinichi.jp"

# ═══════════════════════════════════════
# 文件存储 - 阿里云 OSS（推荐）；如继续用本地盘，确保挂载持久卷
# ═══════════════════════════════════════
# STORAGE_DRIVER 取值：local | oss
STORAGE_DRIVER="oss"
UPLOAD_DIR="/var/lib/chinichi/uploads"
OSS_REGION="oss-cn-hangzhou"
OSS_ACCESS_KEY_ID="REPLACE_ME"
OSS_ACCESS_KEY_SECRET="REPLACE_ME"
OSS_BUCKET="chinichi-graduate"
OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"

# ═══════════════════════════════════════
# 微信开放平台（如启用扫码登录）
# ═══════════════════════════════════════
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# ═══════════════════════════════════════
# 阿里云短信（手机号验证码）
# ═══════════════════════════════════════
SMS_ACCESS_KEY_ID=""
SMS_ACCESS_KEY_SECRET=""
SMS_SIGN_NAME="知日塾"
SMS_TEMPLATE_CODE=""

# ═══════════════════════════════════════
# 钉钉通知（健康检查告警 / 教师推送）
# ═══════════════════════════════════════
DINGTALK_WEBHOOK_URL=""
DINGTALK_SECRET=""
