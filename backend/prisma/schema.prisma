generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model campuses {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(50)
  students   students[]
  user_roles user_roles[]
}

model coaching_records {
  id             String           @id @db.Uuid
  student_id     String           @db.Uuid
  teacher_id     String           @db.Uuid
  coached_at     DateTime         @db.Date
  form           String?          @db.VarChar(20)
  school_ids     String[]         @db.Uuid
  content        String
  next_date      DateTime?        @db.Date
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  students       students         @relation(fields: [student_id], references: [id])
  users          users            @relation(fields: [teacher_id], references: [id])
  coaching_todos coaching_todos[]

  @@index([student_id, coached_at(sort: Desc)], map: "idx_coaching_student")
}

model coaching_todos {
  id                Int                @id @default(autoincrement())
  coaching_id       String             @db.Uuid
  task_id           String?            @db.Uuid
  title             String
  due_date          DateTime?          @db.Date
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  coaching_records  coaching_records   @relation(fields: [coaching_id], references: [id])
  period_plan_tasks period_plan_tasks? @relation(fields: [task_id], references: [id])
}

model file_versions {
  id          String   @id @db.Uuid
  file_id     String   @db.Uuid
  version_no  Int
  oss_key     String
  file_size   BigInt?
  mime_type   String?  @db.VarChar(100)
  uploaded_by String   @db.Uuid
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)
  notes       String?
  files       files    @relation(fields: [file_id], references: [id])
  users       users    @relation(fields: [uploaded_by], references: [id])
}

model files {
  id            String          @id @db.Uuid
  student_id    String          @db.Uuid
  file_type     String          @db.VarChar(50)
  display_name  String          @db.VarChar(200)
  uploaded_by   String          @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  file_versions file_versions[]
  students      students        @relation(fields: [student_id], references: [id])
  users         users           @relation(fields: [uploaded_by], references: [id])
}

model inno_contacts {
  id            Int           @id @default(autoincrement())
  tracking_id   String        @db.Uuid
  method        String?       @db.VarChar(30)
  contact_date  DateTime?     @db.Date
  summary       String?
  created_by    String?       @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  users         users?        @relation(fields: [created_by], references: [id])
  inno_tracking inno_tracking @relation(fields: [tracking_id], references: [id])
}

model inno_tracking {
  id              String          @id @db.Uuid
  school_id       String          @unique @db.Uuid
  status          String          @default("not_started") @db.VarChar(20)
  contact_count   Int             @default(0)
  last_contact_at DateTime?       @db.Date
  confirmed_at    DateTime?       @db.Date
  notes           String?
  updated_at      DateTime        @db.Timestamptz(6)
  inno_contacts   inno_contacts[]
  target_schools  target_schools  @relation(fields: [school_id], references: [id])
}

model notification_deliveries {
  id              Int           @id @default(autoincrement())
  notification_id String        @db.Uuid
  channel         String        @db.VarChar(20)
  status          String        @default("pending") @db.VarChar(20)
  sent_at         DateTime?     @db.Timestamptz(6)
  error_msg       String?
  notifications   notifications @relation(fields: [notification_id], references: [id])
}

model notifications {
  id                      String                    @id @db.Uuid
  user_id                 String                    @db.Uuid
  type                    String                    @db.VarChar(50)
  title                   String                    @db.VarChar(200)
  content                 String?
  related_id              String?                   @db.Uuid
  is_read                 Boolean                   @default(false)
  read_at                 DateTime?                 @db.Timestamptz(6)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  notification_deliveries notification_deliveries[]
  users                   users                     @relation(fields: [user_id], references: [id])

  @@index([user_id, is_read, created_at(sort: Desc)], map: "idx_notifications_user")
}

model operation_logs {
  id          BigInt    @id @default(autoincrement())
  student_id  String?   @db.Uuid
  actor_id    String?   @db.Uuid
  actor_name  String?   @db.VarChar(50)
  action_type String    @db.VarChar(50)
  target_type String?   @db.VarChar(50)
  target_id   String?   @db.VarChar(100)
  detail      Json?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [actor_id], references: [id])
  students    students? @relation(fields: [student_id], references: [id])

  @@index([student_id, created_at(sort: Desc)], map: "idx_op_logs_student")
}

model period_plan_tasks {
  id             String           @id @db.Uuid
  plan_id        String           @db.Uuid
  title          String           @db.VarChar(200)
  description    String?
  due_date       DateTime?        @db.Date
  due_time       String?          @db.VarChar(10)
  priority       String           @default("中") @db.VarChar(10)
  repeat_type    String           @default("once") @db.VarChar(20)
  sort_order     Int              @default(0)
  status         String           @default("pending") @db.VarChar(20)
  done_at        DateTime?        @db.Timestamptz(6)
  done_note      String?
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  coaching_todos coaching_todos[]
  period_plans   period_plans     @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@index([due_date], map: "idx_tasks_due")
  @@index([plan_id, status], map: "idx_tasks_plan")
}

model period_plans {
  id                                     String               @id @db.Uuid
  student_id                             String               @db.Uuid
  period_code                            String               @db.VarChar(20)
  stage_name                             String               @db.VarChar(100)
  goal                                   String?
  start_date                             DateTime             @db.Date
  end_date                               DateTime             @db.Date
  version                                Int                  @default(1)
  status                                 plan_status          @default(draft)
  change_reason                          String?
  previous_plan_id                       String?              @db.Uuid
  created_by                             String?              @db.Uuid
  created_at                             DateTime             @default(now()) @db.Timestamptz(6)
  sent_at                                DateTime?            @db.Timestamptz(6)
  confirmed_at                           DateTime?            @db.Timestamptz(6)
  confirmed_by                           String?              @db.Uuid
  period_plan_tasks                      period_plan_tasks[]
  users_period_plans_confirmed_byTousers users?               @relation("period_plans_confirmed_byTousers", fields: [confirmed_by], references: [id])
  users_period_plans_created_byTousers   users?               @relation("period_plans_created_byTousers", fields: [created_by], references: [id])
  period_plans                           period_plans?        @relation("period_plansToperiod_plans", fields: [previous_plan_id], references: [id])
  other_period_plans                     period_plans[]       @relation("period_plansToperiod_plans")
  students                               students             @relation(fields: [student_id], references: [id])
  plan_confirmations                     plan_confirmations[]

  @@unique([student_id, period_code, version])
  @@index([student_id, status], map: "idx_period_plans_student")
}

model plan_confirmations {
  id           Int          @id @default(autoincrement())
  plan_id      String       @db.Uuid
  action       String       @db.VarChar(20)
  actor_id     String       @db.Uuid
  content      String?
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  users        users        @relation(fields: [actor_id], references: [id])
  period_plans period_plans @relation(fields: [plan_id], references: [id])
}

model risk_tags {
  id                Int                 @id @default(autoincrement())
  code              String              @unique @db.VarChar(50)
  label             String              @db.VarChar(100)
  color             String?             @db.VarChar(20)
  student_risk_tags student_risk_tags[]
}

model roles {
  id         Int          @id @default(autoincrement())
  code       String       @unique @db.VarChar(30)
  name       String       @db.VarChar(50)
  user_roles user_roles[]
}

model school_progress_nodes {
  id             Int            @id @default(autoincrement())
  school_id      String         @db.Uuid
  node_code      String         @db.VarChar(50)
  node_name      String         @db.VarChar(100)
  is_done        Boolean        @default(false)
  done_at        DateTime?      @db.Timestamptz(6)
  done_by        String?        @db.Uuid
  sort_order     Int            @default(0)
  users          users?         @relation(fields: [done_by], references: [id])
  target_schools target_schools @relation(fields: [school_id], references: [id], onDelete: Cascade)
}

model student_risk_tags {
  id                                        Int       @id @default(autoincrement())
  student_id                                String    @db.Uuid
  tag_id                                    Int
  reason                                    String
  tagged_by                                 String    @db.Uuid
  tagged_at                                 DateTime  @default(now()) @db.Timestamptz(6)
  removed_at                                DateTime? @db.Timestamptz(6)
  removed_by                                String?   @db.Uuid
  remove_reason                             String?
  users_student_risk_tags_removed_byTousers users?    @relation("student_risk_tags_removed_byTousers", fields: [removed_by], references: [id])
  students                                  students  @relation(fields: [student_id], references: [id])
  risk_tags                                 risk_tags @relation(fields: [tag_id], references: [id])
  users_student_risk_tags_tagged_byTousers  users     @relation("student_risk_tags_tagged_byTousers", fields: [tagged_by], references: [id])

  @@index([student_id], map: "idx_risk_tags_student")
}

model student_teacher {
  id                                      Int       @id @default(autoincrement())
  student_id                              String    @db.Uuid
  teacher_id                              String    @db.Uuid
  started_at                              DateTime  @default(now()) @db.Timestamptz(6)
  ended_at                                DateTime? @db.Timestamptz(6)
  changed_by                              String?   @db.Uuid
  change_reason                           String?
  users_student_teacher_changed_byTousers users?    @relation("student_teacher_changed_byTousers", fields: [changed_by], references: [id])
  students                                students  @relation(fields: [student_id], references: [id])
  users_student_teacher_teacher_idTousers users     @relation("student_teacher_teacher_idTousers", fields: [teacher_id], references: [id])
}

model students {
  id                String              @id @db.Uuid
  user_id           String              @unique @db.Uuid
  campus_id         Int?
  subject_id        Int?
  entry_date        DateTime?           @db.Date
  target_year       String?             @db.VarChar(20)
  target_season     String?             @db.VarChar(30)
  jlpt_level        String?             @db.VarChar(10)
  jlpt_score        Int?
  undergrad_major   String?             @db.VarChar(100)
  undergrad_gpa     Decimal?            @db.Decimal(3, 2)
  notes             String?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @db.Timestamptz(6)
  coaching_records  coaching_records[]
  files             files[]
  operation_logs    operation_logs[]
  period_plans      period_plans[]
  student_risk_tags student_risk_tags[]
  student_teacher   student_teacher[]
  campuses          campuses?           @relation(fields: [campus_id], references: [id])
  subjects          subjects?           @relation(fields: [subject_id], references: [id])
  users             users               @relation(fields: [user_id], references: [id])
  target_schools    target_schools[]

  @@index([campus_id], map: "idx_students_campus")
  @@index([subject_id], map: "idx_students_subject")
}

model subjects {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(50)
  code       String       @db.VarChar(20)
  students   students[]
  user_roles user_roles[]
}

model target_schools {
  id                    String                  @id @db.Uuid
  student_id            String                  @db.Uuid
  university_name       String                  @db.VarChar(200)
  department            String?                 @db.VarChar(200)
  rank                  Int?
  professor_name        String?                 @db.VarChar(100)
  professor_url         String?
  exam_types            String[]
  application_start     DateTime?               @db.Date
  application_end       DateTime?               @db.Date
  exam_date             DateTime?               @db.Date
  result_date           DateTime?               @db.Date
  result                String?                 @db.VarChar(20)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  inno_tracking         inno_tracking?
  school_progress_nodes school_progress_nodes[]
  students              students                @relation(fields: [student_id], references: [id])

  @@index([student_id], map: "idx_school_student")
}

model user_roles {
  user_id    String    @db.Uuid
  role_id    Int
  subject_id Int?
  campus_id  Int?
  granted_at DateTime  @default(now()) @db.Timestamptz(6)
  campuses   campuses? @relation(fields: [campus_id], references: [id])
  roles      roles     @relation(fields: [role_id], references: [id])
  subjects   subjects? @relation(fields: [subject_id], references: [id])
  users      users     @relation(fields: [user_id], references: [id])

  @@id([user_id, role_id])
}

model users {
  id                                                    String                  @id @db.Uuid
  name                                                  String                  @db.VarChar(50)
  phone                                                 String?                 @unique @db.VarChar(20)
  wechat_openid                                         String?                 @unique @db.VarChar(100)
  email                                                 String?                 @db.VarChar(100)
  avatar_url                                            String?
  is_active                                             Boolean                 @default(true)
  created_at                                            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                            DateTime                @db.Timestamptz(6)
  password_hash                                         String?                 @db.VarChar(100)
  coaching_records                                      coaching_records[]
  file_versions                                         file_versions[]
  files                                                 files[]
  inno_contacts                                         inno_contacts[]
  notifications                                         notifications[]
  operation_logs                                        operation_logs[]
  period_plans_period_plans_confirmed_byTousers         period_plans[]          @relation("period_plans_confirmed_byTousers")
  period_plans_period_plans_created_byTousers           period_plans[]          @relation("period_plans_created_byTousers")
  plan_confirmations                                    plan_confirmations[]
  school_progress_nodes                                 school_progress_nodes[]
  student_risk_tags_student_risk_tags_removed_byTousers student_risk_tags[]     @relation("student_risk_tags_removed_byTousers")
  student_risk_tags_student_risk_tags_tagged_byTousers  student_risk_tags[]     @relation("student_risk_tags_tagged_byTousers")
  student_teacher_student_teacher_changed_byTousers     student_teacher[]       @relation("student_teacher_changed_byTousers")
  student_teacher_student_teacher_teacher_idTousers     student_teacher[]       @relation("student_teacher_teacher_idTousers")
  students                                              students?
  user_roles                                            user_roles[]
}

enum plan_status {
  draft
  pending
  change_pending
  active
  completed
  cancelled
}
