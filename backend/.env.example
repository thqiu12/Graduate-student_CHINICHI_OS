# 知日塾大学院考学进度管理系统 - 后端环境变量配置示例
# 复制此文件为 .env 并填写真实配置

# ═══════════════════════════════════════
# 数据库配置
# ═══════════════════════════════════════
DATABASE_URL="postgresql://chinichi:chinichi_dev_pass@localhost:5432/chinichi_graduate?schema=public"

# ═══════════════════════════════════════
# Redis 配置
# ═══════════════════════════════════════
REDIS_URL="redis://localhost:6379"

# ═══════════════════════════════════════
# JWT 认证配置
# ═══════════════════════════════════════
# 生产环境必须替换为 ≥32 字符的高熵随机串；不可使用本文件中的占位值。
# 生成示例: openssl rand -base64 48
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# Access Token 有效期（默认 2 小时）
JWT_ACCESS_EXPIRES_IN="2h"
# Refresh Token 有效期（默认 30 天）
JWT_REFRESH_EXPIRES_IN="30d"

# ═══════════════════════════════════════
# 初始管理员密码（仅 prisma:seed 使用）
# ═══════════════════════════════════════
# 任何环境都必须设置（≥12 字符），seed 无 fallback，避免误植入弱密码。
INITIAL_ADMIN_PASSWORD=""

# ═══════════════════════════════════════
# 演示账号密码（非生产环境 seed 使用）
# ═══════════════════════════════════════
# 非生产 seed 时为 demo 用户统一设置的密码（不再硬编码 chinichi2026）。
# 生产环境（NODE_ENV=production）会跳过 demo 创建，本项可留空。
DEMO_PASSWORD=""

# ═══════════════════════════════════════
# 开发调试开关
# ═══════════════════════════════════════
# 设为 true 时启用 /auth/phone-login 固定验证码 '123456'（仅 NODE_ENV=development 生效）。
# ⚠️ 任何上线环境都必须保持 false 或不设置。
ENABLE_DEV_SMS_BYPASS="false"

# ═══════════════════════════════════════
# 服务器配置
# ═══════════════════════════════════════
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
UPLOAD_DIR="./uploads"
# CORS：允许的前端域名，逗号分隔。留空时按 NODE_ENV 取默认值（dev=localhost，prod=chinichi.jp）。
# CORS_ORIGIN="https://chinichi.jp,https://staging.chinichi.jp"
# 错误处理：仅在排障时开启，会把内部异常 message 暴露在 500 响应里
EXPOSE_ERROR_DETAILS="false"

# ═══════════════════════════════════════
# 文件存储（local=本地盘 / oss=阿里云 OSS，生产推荐 oss）
# ═══════════════════════════════════════
STORAGE_DRIVER="local"
# local 驱动使用,UPLOAD_DIR 已在上方定义。
# oss 驱动需配齐以下 4 项,缺一启动报错。
OSS_REGION="oss-cn-hangzhou"
OSS_ACCESS_KEY_ID="your-oss-access-key-id"
OSS_ACCESS_KEY_SECRET="your-oss-access-key-secret"
OSS_BUCKET="chinichi-graduate"
OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"

# ═══════════════════════════════════════
# 微信开放平台配置（扫码登录）
# ═══════════════════════════════════════
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="your-wechat-app-secret"

# ═══════════════════════════════════════
# 阿里云短信配置（手机号验证码）
# ═══════════════════════════════════════
SMS_ACCESS_KEY_ID="your-sms-access-key-id"
SMS_ACCESS_KEY_SECRET="your-sms-access-key-secret"
SMS_SIGN_NAME="知日塾"
SMS_TEMPLATE_CODE="SMS_000000"

# ═══════════════════════════════════════
# 钉钉集成配置（老师推送通知）
# ═══════════════════════════════════════
DINGTALK_WEBHOOK_URL="https://oapi.dingtalk.com/robot/send?access_token=your-token"
DINGTALK_SECRET="your-dingtalk-secret"

# ═══════════════════════════════════════
# 日志配置
# ═══════════════════════════════════════
LOG_LEVEL="info"
